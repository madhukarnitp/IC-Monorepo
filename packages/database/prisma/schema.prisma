// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better auth tables

model User {
  id                  String           @id
  name                String?
  email               String?          @unique
  emailVerified       Boolean          @default(false)
  phoneNumber         String?          @unique
  phoneNumberVerified Boolean          @default(false)
  image               String?
  banned              Boolean          @default(false)
  bannedAt            DateTime?
  bannedReason        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  sessions            Session[]
  accounts            Account[]
  trustedDevices      TrustedDevice[]
  roles               UserRole[]
  teamMemberships     TeamMember[]
  applications        Application[]
  createdTasks        Task[]
  taskSubmissions     TaskSubmission[]
  interviews          Interview[]
  notices             Notice[]
  queries             Query[]
  queryResponses      QueryResponse[]

  // Event platform relationships
  eventParticipations EventParticipant[]
  eventStaffRoles     EventStaff[]
  eventScans          EventScan[]
  eventSubmissions    EventSubmission[]
  scanVoteEntries     ResourceScanVoteEntry[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  issuer                String?

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TrustedDevice {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken     String    @unique
  fingerprintHash String
  deviceName      String?
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// RBAC

enum PermissionScope {
  own
  any
}

model Permission {
  id          String          @id @default(cuid())
  resource    String
  action      String
  scope       PermissionScope
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@unique([resource, action, scope])
  @@index([resource])
  @@index([action])
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model AccountRecoveryRequest {
  id           String   @id @default(cuid())
  phoneNumber  String
  status       String   @default("PENDING")
  requestCount Int      @default(1)
  windowStart  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([phoneNumber])
  @@index([windowStart])
}

model OtpCooldown {
  phoneNumber String   @id
  expiresAt   DateTime
}

// Schema design for Induction Portal -->
model Team {
  id              String           @id @default(uuid())
  name            String           @unique @db.VarChar(100)
  description     String?
  createdAt       DateTime         @default(now())
  members         TeamMember[]
  applications    Application[]
  tasks           Task[]
  interviewRounds InterviewRound[]
  noticeTeams     NoticeTeam[]
  queries         Query[]
}

model TeamMember {
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
}

model Application {
  id              String            @id @default(uuid())
  priority        Int
  studentId       String
  teamId          String
  student         User              @relation(fields: [studentId], references: [id])
  team            Team              @relation(fields: [teamId], references: [id])
  currentStatus   ApplicationStatus
  createdAt       DateTime          @default(now())
  taskSubmissions TaskSubmission[]
  interviews      Interview[]

  @@unique([studentId, teamId])
  @@unique([studentId, priority])
}

model Task {
  id              String           @id @default(uuid())
  teamId          String
  team            Team             @relation(fields: [teamId], references: [id])
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])
  title           String           @db.VarChar(100)
  description     String?
  deadline        DateTime
  maxScore        Int
  createdAt       DateTime         @default(now())
  userId          String?
  taskSubmissions TaskSubmission[]
}

model TaskSubmission {
  id            String      @id @default(uuid())
  taskId        String
  task          Task        @relation(fields: [taskId], references: [id])
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  evaluatedById String?
  evaluatedBy   User?       @relation(fields: [evaluatedById], references: [id])
  submissionUrl String
  score         Int?
  feedback      String?
  submittedAt   DateTime    @default(now())
}

model InterviewRound {
  id                   String                @id @default(uuid())
  teamId               String
  team                 Team                  @relation(fields: [teamId], references: [id])
  roundNumber          Int
  roundName            String                @db.VarChar(100)
  evaluationParameters EvaluationParameter[]
  interviews           Interview[]
}

model EvaluationParameter {
  id                   String                @id @default(uuid())
  roundId              String
  round                InterviewRound        @relation(fields: [roundId], references: [id])
  parameterName        String                @db.VarChar(100)
  weighttage           Int
  interviewEvaluations InterviewEvaluation[]
}

model Interview {
  id                   String                @id @default(uuid())
  applicationId        String
  application          Application           @relation(fields: [applicationId], references: [id])
  roundId              String
  round                InterviewRound        @relation(fields: [roundId], references: [id])
  InterviewerId        String
  interviewer          User                  @relation(fields: [InterviewerId], references: [id])
  interviewNotes       String?
  conductAt            DateTime
  interviewEvaluations InterviewEvaluation[]
}

model InterviewEvaluation {
  id          String              @id @default(uuid())
  interviewId String
  interview   Interview           @relation(fields: [interviewId], references: [id])
  parameterId String
  parameter   EvaluationParameter @relation(fields: [parameterId], references: [id])
  rawScore    Int

  @@unique([interviewId, parameterId])
}

model Notice {
  id          String       @id @default(uuid())
  postedBy    String
  posted      User         @relation(fields: [postedBy], references: [id])
  title       String       @db.VarChar(100)
  content     String
  isGlobal    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  noticeTeams NoticeTeam[]
}

model NoticeTeam {
  noticeId String
  notice   Notice @relation(fields: [noticeId], references: [id])
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id])

  @@id([noticeId, teamId])
}

enum QueryStatus {
  OPEN
  RESOLVED
}

model Query {
  id             String          @id @default(uuid())
  studentId      String
  student        User            @relation(fields: [studentId], references: [id])
  teamId         String
  team           Team            @relation(fields: [teamId], references: [id])
  subject        String          @db.VarChar(100)
  message        String
  status         QueryStatus     @default(OPEN)
  createdAt      DateTime        @default(now())
  queryResponses QueryResponse[]
}

model QueryResponse {
  id         String   @id @default(uuid())
  queryId    String
  query      Query    @relation(fields: [queryId], references: [id])
  responseId String
  responder  User     @relation(fields: [responseId], references: [id])
  response   String
  createdAt  DateTime @default(now())
}

// ==========================================
// EVENT PLATFORM
// ==========================================

enum EventType {
  STARTUP_HUNT
  TREASURE_HUNT
  HACKATHON
  QUIZ
  COMPETITION
  CUSTOM
}

enum EventStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ACTIVE
  BUILDING
  SUBMISSIONS_OPEN
  SUBMISSIONS_CLOSED
  COMPLETED
  CANCELLED
}

enum CheckpointType {
  QR
  CODE
  NFC
  LOCATION
  MANUAL
  CUSTOM
}

enum EventStaffRole {
  OWNER
  ADMIN
  STAFF
  JUDGE
  VIEWER
}


model Event {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?

  type        EventType
  status      EventStatus @default(DRAFT)

  startsAt    DateTime?
  endsAt      DateTime?

  config      Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants EventParticipant[]
  teams        EventTeam[]
  staff        EventStaff[]
  checkpoints  EventCheckpoint[]
  resources    EventResource[]
  submissions  EventSubmission[]

  @@index([type])
  @@index([status])
}


model EventParticipant {
  id           String   @id @default(uuid())

  eventId      String
  userId       String

  registeredAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamMemberships EventTeamMember[]
  teamJoinRequests TeamJoinRequest[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventTeam {
  id          String @id @default(uuid())

  eventId     String
  name        String

  totalPoints Int @default(0)

  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  members       EventTeamMember[]
  checkpoints   EventTeamCheckpoint[]
  scans         EventScan[]
  resources     EventTeamResource[]
  submissions   EventSubmission[]
  joinRequests  TeamJoinRequest[]
  scanVotes     ResourceScanVote[]
  cooldown      TeamScanCooldown?

  @@unique([eventId, name])
  @@index([eventId])
}

model EventTeamMember {
  id            String @id @default(uuid())

  participantId String @unique
  teamId        String

  joinedAt      DateTime @default(now())

  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team        EventTeam        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}


model EventStaff {
  id        String @id @default(uuid())

  eventId   String
  userId    String

  role      EventStaffRole

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}


model EventResource {
  id           String @id @default(uuid())

  eventId      String

  name         String
  description  String?
  type         String

  content      Json?

  active       Boolean @default(true)

  // Quantity tracking
  quantity     Int     @default(1)  // total units available
  quantityUsed Int     @default(0)  // units already claimed

  // HMAC secret for QR signing (server-only, never sent to client)
  hmacSecret   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  teamResources    EventTeamResource[]
  scanVotes        ResourceScanVote[]

  @@index([eventId])
}

model EventTeamResource {
  id           String @id @default(uuid())

  teamId       String
  resourceId   String

  checkpointId String?

  unlockedAt   DateTime @default(now())

  team     EventTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  resource EventResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([teamId, resourceId])
  @@index([teamId])
  @@index([resourceId])
}


model EventCheckpoint {
  id        String @id @default(uuid())

  eventId   String
  sequence  Int

  name      String?
  type      CheckpointType

  points    Int @default(0)

  config    Json?

  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  teamCheckpoints EventTeamCheckpoint[]

  @@unique([eventId, sequence])
  @@index([eventId])
}

model EventTeamCheckpoint {
  id           String @id @default(uuid())

  teamId       String
  checkpointId String

  tokenHash    String @unique

  status       String @default("LOCKED")

  assignedAt   DateTime @default(now())
  completedAt  DateTime?

  team       EventTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  checkpoint EventCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  scans EventScan[]

  @@unique([teamId, checkpointId])
  @@index([teamId])
  @@index([checkpointId])
}

model EventScan {
  id               String @id @default(uuid())

  teamId           String
  teamCheckpointId String

  scannedByUserId  String

  pointsAwarded    Int @default(0)

  scannedAt        DateTime @default(now())

  team           EventTeam           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamCheckpoint EventTeamCheckpoint @relation(fields: [teamCheckpointId], references: [id], onDelete: Cascade)
  scannedBy      User                @relation(fields: [scannedByUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, teamCheckpointId])
  @@index([teamId])
  @@index([scannedByUserId])
  @@index([scannedAt])
}

model EventSubmission {
  id        String @id @default(uuid())

  eventId   String
  teamId    String?

  submittedByUserId String?

  data      Json

  status    String @default("DRAFT")

  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team        EventTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedBy User?      @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([teamId])
}

model TeamJoinRequest {
  id            String @id @default(uuid())
  teamId        String
  participantId String
  status        String @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team        EventTeam        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([teamId, participantId])
  @@index([teamId])
  @@index([participantId])
}

// ==========================================
// TEAM CONSENSUS SCAN VOTING
// ==========================================

// A vote session created when a team member initiates a QR scan
model ResourceScanVote {
  id          String   @id @default(uuid())

  teamId      String
  resourceId  String
  eventId     String

  initiatedBy String   // userId of the member who scanned

  // PENDING | ACCEPTED | DECLINED | EXPIRED
  status      String   @default("PENDING")

  expiresAt   DateTime
  resolvedAt  DateTime?

  createdAt   DateTime @default(now())

  team     EventTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  resource EventResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  votes ResourceScanVoteEntry[]

  @@index([teamId])
  @@index([resourceId])
  @@index([status])
}

// Each member's individual vote within a session
model ResourceScanVoteEntry {
  id        String   @id @default(uuid())

  sessionId String
  userId    String

  // PENDING | ACCEPTED | DECLINED
  vote      String   @default("PENDING")

  votedAt   DateTime?

  session ResourceScanVote @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
}

// Cooldown lock per team after a decline
model TeamScanCooldown {
  id        String   @id @default(uuid())

  teamId    String   @unique
  expiresAt DateTime
  reason    String?  // who declined / why

  createdAt DateTime @default(now())

  team EventTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
